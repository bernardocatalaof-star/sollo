# --- Database ---
# Local default (fine for testing on your own computer):
DATABASE_URL=sqlite:///./data/sollo.db
# When hosting online, use a persistent Postgres database instead -- local SQLite
# files get wiped when most free hosting platforms redeploy/restart the app.
# Paste the connection string your provider (e.g. Neon) gives you exactly as-is --
# postgres:// / postgresql:// are both accepted and normalized automatically.

# --- Sheets sync source ---
# One of: local_csv | csv_url | service_account | oauth_user
SHEETS_SOURCE_MODE=local_csv

# Used when SHEETS_SOURCE_MODE=local_csv (handy for testing without any Google setup)
SHEETS_LOCAL_CSV_PATH=./data/sample_bookings.csv

# Used when SHEETS_SOURCE_MODE=csv_url (File > Share > Publish to web > CSV, on the bookings tab)
# Note: this makes the sheet's data readable by anyone with the link -- avoid if it
# contains guest PII (name/email/address/phone), which a platform export usually does.
SHEETS_CSV_URL=

# Used when SHEETS_SOURCE_MODE=service_account
# Requires your GCP org to allow service account key creation -- if you hit
# "iam.disableServiceAccountKeyCreation", use oauth_user below instead.
GOOGLE_SERVICE_ACCOUNT_JSON=./data/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET=Bookings

# Used when SHEETS_SOURCE_MODE=oauth_user -- authenticates as your own Google
# account via a one-time browser click instead of a service account key.
# Not affected by org policies that block service account keys.
# Either a file path OR the raw JSON content of the downloaded OAuth client
# credentials pasted directly (useful on hosts where you set env vars via a web
# form instead of uploading files).
GOOGLE_OAUTH_CLIENT_SECRET_JSON=./data/oauth_client_secret.json
# Must exactly match an "Authorized redirect URI" on the OAuth client in Google
# Cloud Console. Change the host part to your hosted app's URL when deployed.
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# --- Column mapping ---
# Map the app's internal fields to the exact header names used in your Sheet.
# Adjust these to match your Sheet without touching any code.
# Defaults below match a reservations-platform export (id, reference, state,
# customer_first_name, products, start_on, end_on, net_paid, ...).
COL_EXTERNAL_ID=reference
# Leave COL_GUEST_NAME blank to compose "First Last" from the two columns below instead.
COL_GUEST_NAME=
COL_CUSTOMER_FIRST_NAME=customer_first_name
COL_CUSTOMER_LAST_NAME=customer_last_name
COL_CUSTOMER_PHONE=customer_mobile_number
COL_CABIN=products
COL_CHECK_IN=start_on
COL_CHECK_OUT=end_on
# Date the reservation was actually made (not check-in/check-out) -- powers the
# "Sales this month" dashboard card. Leave as-is if your sheet has no such column;
# missing/unparseable values are just left blank rather than failing the sync.
COL_BOOKED_AT=booked_at
COL_TOTAL_PRICE=net_paid
COL_BOOKING_SOURCE=sales_channel
COL_STATUS=state

# Comma-separated list of `state` values that count as a real, billable stay.
# Everything else (cancelled, pending, quote, etc.) is skipped on sync.
BILLABLE_STATES=completed
